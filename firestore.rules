rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownerPath() { return /databases/$(database)/documents/admin/owner; }
    function membersPath() { return /databases/$(database)/documents/admin/members; }
    function isOwner() { return signedIn() && exists(ownerPath()) && get(ownerPath()).data.uid == request.auth.uid; }
    function me() { return exists(membersPath()) ? get(membersPath()).data.map.get(request.auth.uid, {}) : {}; }
    function role() { return me().get('role', ''); }
    function isAdmin() { return isOwner() || role() == 'admin'; }
    function inProject(p) { return isAdmin() || (signedIn() && p in me().get('projects', [])); }
    function staff() { return isAdmin() || role() in ['hse', 'supervisor']; }

    // System owner: the first person who signs in. Cannot be changed from the app.
    match /admin/owner {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }
    // Projects, members, score-card reviews: everyone signed in reads, only admins write.
    match /admin/{d} {
      allow read: if signedIn();
      allow write: if d != 'owner' && isAdmin();
    }
    match /admin/{d}/{c}/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // Name directory used to find colleagues.
    match /people/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
    // Site reports: anyone on the project reports; HSE closes.
    match /reports/{id} {
      allow read: if inProject(resource.data.project);
      allow create: if inProject(request.resource.data.project)
                    && (request.resource.data.by == null || request.resource.data.by == request.auth.uid);
      allow update: if (isAdmin() || role() == 'hse') && inProject(resource.data.project)
                    && request.resource.data.project == resource.data.project;
      allow delete: if isAdmin();
    }
    // Actions, inspections, activity logs: staff on the project write.
    match /actions/{id} {
      allow read: if inProject(resource.data.project);
      allow create, update: if staff() && inProject(request.resource.data.project);
      allow delete: if isAdmin();
    }
    match /inspections/{id} {
      allow read: if inProject(resource.data.project);
      allow create: if staff() && inProject(request.resource.data.project);
      allow update, delete: if isAdmin();
    }
    match /activities/{id} {
      allow read: if inProject(resource.data.project);
      allow create: if staff() && inProject(request.resource.data.project);
      allow update, delete: if isAdmin();
    }
  }
}
